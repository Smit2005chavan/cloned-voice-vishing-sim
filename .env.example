# Copy this file to ".env" and fill in your own values.
# Never commit or share the real ".env" file — it holds live secrets.

TWILIO_SID=
TWILIO_TOKEN=
TWILIO_NUMBER=+1XXXXXXXXXX
# Number this demo will call. Use a number YOU own or are explicitly authorized to test with.
CALLEE_NUMBER=+91XXXXXXXXXX
DEEPGRAM_API_KEY=
GEMINI_API_KEY=
# Optional — only needed if you have a paid/registered ngrok account.
NGROK_AUTHTOKEN=

# Optional — real-time cloned-voice replies via a GPU relay (see
# kaggle_tts_server.py). Leave blank to use the fixed pre-recorded clips
# instead. Get these by running kaggle_tts_server.py on a Kaggle GPU
# notebook and copying the printed URL/key here before each call.
TTS_RELAY_URL=
TTS_RELAY_KEY=
